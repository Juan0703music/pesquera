// Marea — software de una pesquera: pedidos, despacho, inventario, ventas del día y analíticas en vivo.
//
// Convenciones:
// - Dinero: enteros en pesos colombianos (COP), sin decimales.
// - Cantidades: enteros en milésimas («milli»). Por kilo → gramos (1,5 kg = 1500).
//   Por unidad → milésimas de unidad (3 unidades = 3000), así todo se suma igual y sin errores de redondeo.
// - Precios: por kilo (unit = KG) o por unidad (unit = UNIDAD).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enumeraciones ───────────────────────────────

/// ADMIN: el dueño o administrador (todo). VENTAS: recibe pedidos y cobra. DESPACHO: alista, pesa y despacha.
/// BODEGA: entradas de mercancía, ajustes y mermas.
enum Role {
  ADMIN
  VENTAS
  DESPACHO
  BODEGA
}

enum Unit {
  KG
  UNIDAD
}

enum OrderSource {
  MOSTRADOR
  TELEFONO
  WHATSAPP
  WEB
}

/// RECIBIDO → ALISTANDO (pesaje) → LISTO → DESPACHADO (va en camino) → ENTREGADO. CANCELADO en cualquier momento.
/// El inventario se descuenta al salir de la pesquera (DESPACHADO, o ENTREGADO si el cliente recoge).
enum OrderStatus {
  RECIBIDO
  ALISTANDO
  LISTO
  DESPACHADO
  ENTREGADO
  CANCELADO
}

enum DeliveryType {
  RECOGE
  DOMICILIO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  NEQUI
  DATAFONO
  CREDITO
  /// Pago inmediato a una llave Bre-B (desde cualquier banco o billetera).
  BRE_B
}

/// Dónde recibe pagos la pesquera. BRE_B: llave (celular, documento, correo, @alias o código de comercio).
/// NEQUI y DAVIPLATA: número de la billetera. BANCO: cuenta de ahorros o corriente.
enum PaymentAccountKind {
  BRE_B
  NEQUI
  DAVIPLATA
  BANCO
}

enum BankAccountType {
  AHORROS
  CORRIENTE
}

/// ENTRADA: llega mercancía (barco, proveedor). SALIDA_PEDIDO: se despacha un pedido. DEVOLUCION: se anula un
/// pedido ya despachado. AJUSTE: conteo físico. MERMA: pérdida (se dañó, deshidratación, limpieza).
enum MovementType {
  ENTRADA
  SALIDA_PEDIDO
  DEVOLUCION
  AJUSTE
  MERMA
}

// ─────────────────────────────── Configuración ───────────────────────────────

/// Una sola fila (id = 1): datos de la pesquera y de la tienda en línea.
model Setting {
  id            Int      @id @default(1)
  businessName  String   @map("business_name")
  phone         String?
  whatsapp      String?
  address       String?
  storeOpen     Boolean  @default(true) @map("store_open")
  deliveryFee   Int      @default(0) @map("delivery_fee")
  minOrderTotal Int      @default(0) @map("min_order_total")
  /// Hay logo cargado (ver BusinessLogo).
  hasLogo       Boolean  @default(false) @map("has_logo")
  /// Sube con cada logo nuevo y nunca baja: la dirección de la imagen cambia y el navegador no muestra el viejo.
  logoVersion   Int      @default(0) @map("logo_version")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// Logo de la pesquera (una sola fila). Se guarda normalizado (PNG cuadrado de hasta 1024 px, sin metadatos);
/// los tamaños (panel, tienda, ícono de la pestaña) se generan al pedirlos. No va en el repositorio: es del negocio.
model BusinessLogo {
  id        Int      @id @default(1)
  image     Bytes
  /// Logo redondo: se muestra y se recorta como círculo.
  round     Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_logo")
}

/// Cuentas para recibir pagos (se muestran al cliente en la tienda, en el seguimiento y en el mostrador).
/// Del QR solo se guarda el código que contiene (leído del pantallazo que da el banco); la imagen se dibuja de nuevo.
model PaymentAccount {
  id             String             @id @default(uuid(7)) @db.Uuid
  kind           PaymentAccountKind
  /// Llave Bre-B, número de Nequi/Daviplata o número de cuenta.
  accountKey     String             @map("account_key")
  holderName     String             @map("holder_name")
  /// Cédula o NIT del titular (opcional; lo piden algunas transferencias).
  holderDocument String?            @map("holder_document")
  bankName       String?            @map("bank_name")
  bankAccountType BankAccountType?  @map("bank_account_type")
  /// Contenido del QR de cobro (p. ej. el código EMVCo de Bre-B).
  qrPayload      String?            @map("qr_payload")
  /// Se muestra a los clientes (tienda y seguimiento).
  active         Boolean            @default(true)
  sortOrder      Int                @default(0) @map("sort_order")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payment_accounts")
}

// ─────────────────────────────── Avisos al celular (Web Push) ───────────────────────────────

/// Un celular o computador que recibe avisos («Pedido nuevo») aunque la app esté cerrada.
/// El navegador entrega la dirección (endpoint) y las llaves; si deja de existir se borra al primer envío fallido.
model PushSubscription {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  endpoint    String    @unique
  p256dh      String
  auth        String
  /// «Android · Chrome», «Windows · Edge»… para reconocer el equipo.
  device      String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSentAt  DateTime? @map("last_sent_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Llaves VAPID con que el servidor firma los avisos. Se crean solas la primera vez (una sola fila);
/// si se definen VAPID_PUBLIC_KEY y VAPID_PRIVATE_KEY, mandan esas.
model WebPushKeys {
  id         Int      @id @default(1)
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("web_push_keys")
}

// ─────────────────────────────── Personal y sesiones ───────────────────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  /// Se registró desde el inicio de sesión y espera que el administrador la apruebe (mientras tanto, active = false).
  pendingApproval Boolean @default(false) @map("pending_approval")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions  Session[]
  pushSubscriptions PushSubscription[]
  orders    Order[]             @relation("OrderCreatedBy")
  movements InventoryMovement[]
  events    OrderEvent[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────── Catálogo e inventario ───────────────────────────────

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(uuid(7)) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  name          String   @unique
  description   String?
  unit          Unit
  /// Precio de venta por kilo o por unidad (COP).
  price         Int
  /// Costo promedio ponderado por kilo o por unidad (COP), se actualiza con cada entrada.
  avgCost       Int      @default(0) @map("avg_cost")
  /// Existencia física en milésimas (gramos si es por kilo).
  stockMilli    Int      @default(0) @map("stock_milli")
  /// Por debajo de este nivel se avisa «stock bajo».
  minStockMilli Int      @default(0) @map("min_stock_milli")
  active        Boolean  @default(true)
  /// Se muestra en la tienda en línea.
  inStore       Boolean  @default(true) @map("in_store")
  /// Cómo lo puede pedir el cliente: «Entero», «Limpio», «En postas», «En filete»… (vacío: sin opciones).
  cutOptions    String[] @default([]) @map("cut_options")
  /// Sube cada vez que cambia la foto (la dirección de la imagen cambia y el navegador no usa la vieja).
  photoVersion  Int      @default(0) @map("photo_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  Category            @relation(fields: [categoryId], references: [id])
  movements InventoryMovement[]
  items     OrderItem[]
  photo     ProductPhoto?

  @@index([categoryId])
  @@map("products")
}

/// Foto del producto, ya procesada (WebP sin metadatos): grande para la ficha y pequeña para las listas.
/// Va en su propia tabla para que listar productos nunca cargue imágenes.
model ProductPhoto {
  productId String   @id @map("product_id") @db.Uuid
  large     Bytes
  small     Bytes
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_photos")
}

model InventoryMovement {
  id              String       @id @default(uuid(7)) @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  type            MovementType
  /// Cambio en la existencia (positivo entra, negativo sale), en milésimas.
  qtyMilli        Int          @map("qty_milli")
  /// Existencia después del movimiento.
  stockAfterMilli Int          @map("stock_after_milli")
  /// Costo por kilo o unidad de una entrada (COP).
  unitCost        Int?         @map("unit_cost")
  supplier        String?
  note            String?
  orderId         String?      @map("order_id") @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ─────────────────────────────── Clientes y pedidos ───────────────────────────────

model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// Celular normalizado 57XXXXXXXXXX.
  phone     String   @unique
  address   String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("customers")
}

model Order {
  id              String        @id @default(uuid(7)) @db.Uuid
  number          Int           @unique @default(autoincrement())
  source          OrderSource
  status          OrderStatus   @default(RECIBIDO)
  deliveryType    DeliveryType  @map("delivery_type")
  customerId      String?       @map("customer_id") @db.Uuid
  customerName    String        @map("customer_name")
  customerPhone   String?       @map("customer_phone")
  address         String?
  notes           String?
  paymentMethod   PaymentMethod @map("payment_method")
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  /// Suma de las líneas: con el peso real si ya se pesó, si no con lo pedido.
  subtotal        Int
  deliveryFee     Int           @default(0) @map("delivery_fee")
  total           Int
  /// SHA-256 de la clave con la que el cliente de la tienda en línea sigue su pedido.
  trackingKeyHash String?       @map("tracking_key_hash")
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  preparingAt     DateTime?     @map("preparing_at") @db.Timestamptz(3)
  readyAt         DateTime?     @map("ready_at") @db.Timestamptz(3)
  /// Momento de la venta: sale de la pesquera y se descuenta del inventario.
  dispatchedAt    DateTime?     @map("dispatched_at") @db.Timestamptz(3)
  deliveredAt     DateTime?     @map("delivered_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?       @map("cancel_reason")
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer  Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     OrderItem[]
  events    OrderEvent[]
  movements InventoryMovement[]

  @@index([status])
  @@index([dispatchedAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  productName    String  @map("product_name")
  unit           Unit
  unitPrice      Int     @map("unit_price")
  /// Lo que pidió el cliente (milésimas).
  qtyMilli       Int     @map("qty_milli")
  /// Peso o cantidad real al alistar (milésimas). Si es null se despacha lo pedido.
  actualQtyMilli Int?    @map("actual_qty_milli")
  lineTotal      Int     @map("line_total")
  /// Indicaciones: «limpio», «en filete», «sin cabeza»…
  note           String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Historial de cada pedido (quién lo movió y cuándo). Alimenta la actividad en vivo.
model OrderEvent {
  id        String      @id @default(uuid(7)) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  userId    String?     @map("user_id") @db.Uuid
  note      String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_events")
}
