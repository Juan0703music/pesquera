# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=3100
# URL con la que se abre la aplicación (enlaces de seguimiento de pedidos y CORS).
APP_URL=http://localhost:3100
# Número de proxies delante de la app (1 detrás de Nginx/Caddy). 0 en local.
TRUST_PROXY=0
LOG_LEVEL=info

# ─── Base de datos ──────────────────────────────────────────
# En local, `npm run db:start` levanta PostgreSQL embebido en el puerto 5434.
# En producción (Supabase): la URL del «Session pooler» terminada en ?sslmode=require. Guía: docs/produccion.md
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/pesquera
# Cifrado: auto (local sin cifrar; remota cifrada, y verificada si hay certificado), disable, require, verify-full.
DATABASE_SSL=auto
# Certificado de Supabase (Database Settings → SSL): el texto PEM, en base64 o la ruta al archivo .crt.
DATABASE_CA_CERT=
# Conexiones simultáneas a la base.
DATABASE_POOL_MAX=5

# ─── Primera cuenta ─────────────────────────────────────────
# Código para crear la cuenta del administrador en un servidor nuevo (mínimo 12 caracteres).
# Obligatorio en producción mientras no haya ninguna cuenta. En local es opcional.
SETUP_CODE=

# ─── Sesiones ───────────────────────────────────────────────
SESSION_TTL_DAYS=7
# true en producción (HTTPS). En local con http debe ser false.
COOKIE_SECURE=false

# ─── Negocio ────────────────────────────────────────────────
# Zona horaria para "ventas del día" y reportes.
TIME_ZONE=America/Bogota

# ─── Copias de seguridad (npm run db:backup) ────────────────
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# Servidor donde se prueba la restauración (por defecto el PostgreSQL local de `npm run db:start`).
# BACKUP_VERIFY_URL=postgresql://postgres:postgres@localhost:5434/postgres
