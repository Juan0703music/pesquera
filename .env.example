# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=3100
# URL con la que se abre la aplicación (enlaces de seguimiento de pedidos y CORS).
APP_URL=http://localhost:3100
# Número de proxies delante de la app (1 detrás de Nginx/Caddy). 0 en local.
TRUST_PROXY=0
LOG_LEVEL=info

# ─── Base de datos ──────────────────────────────────────────
# En local, `npm run db:start` levanta PostgreSQL embebido en el puerto 5434.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/pesquera

# ─── Sesiones ───────────────────────────────────────────────
SESSION_TTL_DAYS=7
# true en producción (HTTPS). En local con http debe ser false.
COOKIE_SECURE=false

# ─── Negocio ────────────────────────────────────────────────
# Zona horaria para "ventas del día" y reportes.
TIME_ZONE=America/Bogota
